#!/usr/bin/env bash
set -euo pipefail
APP_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ "${1:-}" == "--panes" && -z "${TMUX:-}" ]]; then
  if command -v tmux >/dev/null 2>&1; then
    SESSION="secassist-$(date +%s)-$$"
    printf -v RUN '%q ' python3 "$APP_DIR/secassist.py" "$@"
    exec tmux new-session -s "$SESSION" "$RUN"
  fi
  echo "tmux is missing; starting single terminal. Install: sudo apt install tmux"
fi
exec python3 "$APP_DIR/secassist.py" "$@"
